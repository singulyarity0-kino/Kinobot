# Botfather'dan olingan bot tokeni
BOT_TOKEN=123456789:AAExampleTokenHere

# Botni birinchi ishga tushirganda admin bo'lib kiradigan Telegram ID(lar),
# vergul bilan ajratilgan (o'z ID'ingizni @userinfobot orqali bilib olishingiz mumkin)
SUPER_ADMIN_IDS=123456789

# Yangi kino qo'shilganda avtomatik e'lon qilinadigan asosiy kanal.
# @kanal_username yoki -100... ko'rinishida. Bot kanalga admin qilib qo'shilgan bo'lishi shart.
MAIN_CHANNEL=@your_channel

# Ixtiyoriy: baza va log fayllari joylashuvi
DB_PATH=kino.db
BACKUP_DIR=backups
LOG_FILE=bot.log

# Ixtiyoriy: videolar nusxasi saqlanadigan YOPIQ zaxira kanali (@username yoki -100...).
# Admin paneldan ham ulash mumkin. Bot kanalga admin qilib qo'shilgan bo'lishi shart.
BACKUP_CHANNEL=

# TMDB (kino ma'lumotlarini avtomatik to'ldirish: poster, tavsif, rejissyor, aktyorlar, treyler).
# Bepul kalit: https://www.themoviedb.org/settings/api  — ikkalasidan BIRINI kiriting:
TMDB_API_KEY=
TMDB_READ_TOKEN=
# Tavsif tili: ru-RU (tavsiya), en-US ...
TMDB_LANGUAGE=ru-RU

# Gemini (Google AI Studio, bepul kalit: https://aistudio.google.com) — tavsifni o'zbekcha qiziqarli
# qilib yozish, kanal posti jumlasi, janr taklifi va tarjima uchun.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Tarjima zanjiri: auto (standart) = Gemini -> Claude (kalit bo'lsa) -> Google -> MyMemory
# Boshqa qiymatlar: gemini | claude | google | mymemory | off
TRANSLATE_PROVIDER=auto
ANTHROPIC_API_KEY=
# MyMemory uchun ixtiyoriy email (kunlik limit ko'payadi)
MYMEMORY_EMAIL=

# Avtomatik karta to'lovi (Telegram Bot Payments): @BotFather -> /mybots -> botingiz -> Payments ->
# provayderni tanlang (masalan Click) -> bergan "token"ni shu yerga yozing.
# Provayder bilan shartnoma (do'kon/merchant) kerak. Telegram Stars uchun token KERAK EMAS.
PAYMENT_PROVIDER_TOKEN=
